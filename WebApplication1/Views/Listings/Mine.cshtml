@model List<Listing>
@{ ViewData["Title"] = "My Listings"; }
<div class="container section">
    <div class="head">
        <h1>My Listings</h1>
        <a class="btn" href="/Listings/Create">+ New Listing</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty">You have no listings yet.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Title</th><th>Category</th><th>Type</th><th>Rate</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    Listing l = Model[i];
                    <tr>
                        <td><a href="/Listings/Details/@l.Id">@l.Title</a></td>
                        <td>@l.Category</td>
                        <td>@l.Type</td>
                        <td>₱@l.HourlyRate.ToString("0")</td>
                        <td>@(l.IsActive ? "Active" : "Inactive")</td>
                        <td class="actions">
                            <a class="btn sm ghost" href="/Listings/Edit/@l.Id">Edit</a>

                            <form method="post" action="/Listings/Toggle">
                                <input type="hidden" name="id" value="@l.Id" />
                                <button class="btn sm ghost">@(l.IsActive ? "Deactivate" : "Activate")</button>
                            </form>

                            <form method="post" action="/Listings/Delete" onsubmit="return confirm('Delete this listing?');">
                                <input type="hidden" name="id" value="@l.Id" />
                                <button class="btn sm danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>