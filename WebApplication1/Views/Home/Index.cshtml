@model List<Listing>
@{
    ViewData["Title"] = "Home";
    string[] popular = { "Math", "Programming", "Design", "Guitar", "Repair" };
}
<section class="hero">
    <div class="container center">
        <span class="badge">✨ Local tutors &amp; trusted service providers</span>
        <h1>Learn a Skill or <span class="yellow">Hire Someone</span></h1>
        <p class="lead">Find tutors to help you learn or local people who can provide the service you need.</p>

        <form class="search" method="get" action="/Listings">
            <input name="search" placeholder="Search tutors or services..." />
            <button class="btn">Search</button>
        </form>

        <div class="popular">
            <span>Popular:</span>
            @for (int i = 0; i < popular.Length; i++)
            {
                <a class="chip-light" href="/Listings?search=@popular[i]">@popular[i]</a>
            }
        </div>

        <div class="grid3 actions-grid">
            <a class="action" href="/Listings?type=Tutor">
                <div class="ico purple">📖</div><h4>Find a Tutor</h4><p>Learn from someone with experience.</p>
            </a>
            <a class="action" href="/Listings?type=Service">
                <div class="ico green">🔧</div><h4>Hire a Service</h4><p>Get help with a task or repair.</p>
            </a>
            <a class="action" href="/Listings">
                <div class="ico yellow">▦</div><h4>View Everything</h4><p>Browse all available listings.</p>
            </a>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <h2>Featured Tutors and Services</h2>
        <div class="grid3">
            @for (int i = 0; i < Model.Count; i++)
            {
                <partial name="_ListingCard" model="Model[i]" />
            }
        </div>
    </div>
</section>